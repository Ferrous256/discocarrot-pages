---
layout: base.njk
---
<style>
  .listing-hero {
    padding: 160px 48px 60px;
    text-align: center;
  }
  .listing-hero .eyebrow {
    font-family: 'DM Mono', monospace;
    font-size: 0.7rem; letter-spacing: 0.25em; text-transform: uppercase;
    color: var(--orange); margin-bottom: 4px;
  }
  .listing-hero h1 {
    font-family: 'Bebas Neue', sans-serif;
    font-size: clamp(3rem, 7vw, 6rem);
    line-height: 0.95; letter-spacing: 0.02em;
    color: var(--white); margin-bottom: 4px;
  }
  .listing-hero p {
    font-size: 1.05rem; line-height: 1.65;
    color: var(--muted); max-width: 520px; margin: 0 auto;
  }

  .listing-grid {
    display: grid; grid-template-columns: repeat(2, 1fr);
    gap: 24px; padding: 60px 48px 100px;
    max-width: 1100px; margin: 0 auto;
  }
  .listing-card {
    border: 1px solid var(--slate); overflow: hidden;
    transition: border-color 0.3s, transform 0.3s;
    text-decoration: none; display: flex; flex-direction: column;
    justify-content: center;
  }
  .listing-card:hover { border-color: var(--orange); transform: translateY(-4px); }
  .listing-card img {
    width: 100%; height: auto; object-fit: contain; display: block;
    background: var(--deep);
    margin: 0 auto;
  }
  .listing-card-body { padding: 28px; }
  .listing-card-date {
    font-family: 'DM Mono', monospace;
    font-size: 0.62rem; letter-spacing: 0.15em; text-transform: uppercase;
    color: var(--muted); margin-bottom: 10px;
  }
  .listing-card h3 {
    font-family: 'Bebas Neue', sans-serif;
    font-size: 1.6rem; letter-spacing: 0.04em;
    color: var(--white); margin-bottom: 10px; line-height: 1;
  }
  .listing-card p {
    font-size: 0.88rem; color: var(--muted); line-height: 1.6;
  }
  .listing-card .read-more {
    font-family: 'DM Mono', monospace;
    font-size: 0.68rem; letter-spacing: 0.12em; text-transform: uppercase;
    color: var(--orange); margin-top: 16px; display: inline-block;
  }

  @media (max-width: 900px) {
    .listing-hero { padding: 120px 24px 40px; }
    .listing-grid { grid-template-columns: 1fr; padding: 40px 24px 80px; }
  }
</style>

